# Copy to .env and fill in. .env is gitignored. Never commit real keys.
ANTHROPIC_API_KEY=
# Fine-grained GitHub token with read-only access to public repos (raises the rate limit from 60 to 5,000 requests/hour)
GITHUB_TOKEN=
# Max Claude tokens (input + output) the public demo may use per UTC day
DAILY_TOKEN_LIMIT=500000
