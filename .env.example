# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# Any OpenAI-compatible provider works. Defaults are DeepSeek.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Fine-grained GitHub token with read-only access to public repos (raises the rate limit from 60 to 5,000 requests/hour)
GITHUB_TOKEN=

# Max LLM tokens (input + output) the public demo may use per UTC day
DAILY_TOKEN_LIMIT=500000
