# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# Any OpenAI-compatible provider works. Defaults are DeepSeek.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Fine-grained GitHub token with read-only access to public repos (raises the rate limit from 60 to 5,000 requests/hour)
GITHUB_TOKEN=

# --- Public demo protections (web app only) ---
# Max LLM tokens (input + output) per UTC day. 500k is roughly $0.10-0.20/day on deepseek-flash.
DAILY_TOKEN_LIMIT=500000
# Each visitor may generate this many (uncached) digests per window
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=3600
# Identical requests within this time are served from cache (free, not rate limited)
CACHE_TTL_SECONDS=3600
# Set to true only when deployed behind a proxy/load balancer that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false
